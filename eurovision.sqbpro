<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="eurovision.py" readonly="0" foreign_keys="0" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure pragmas query browser" current="2"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1178"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="song_details" custom_title="0" dock_id="1" table="4,12:mainsong_details"/><dock_state state="000000ff00000000fd00000001000000020000057100000368fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005710000015700ffffff000002ce0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="eurovision_winners" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="49"/><column index="2" value="123"/><column index="3" value="300"/><column index="4" value="123"/><column index="5" value="232"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="song_details" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="1" mode="0"/></sort><column_widths><column index="1" value="49"/><column index="2" value="149"/><column index="3" value="129"/><column index="4" value="84"/><column index="5" value="123"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT Count(country)
FROM eurovision_winners
WHERE country IS &quot;Israel&quot;;
</sql><sql name="SQL 2">SELECT Count(country)
FROM eurovision_winners
WHERE country = host_country;
</sql><sql name="SQL 3">SELECT year
FROM eurovision_winners
WHERE country IS &quot;Israel&quot;;
</sql><sql name="SQL 4">Select song_length_seconds
From song_details
ORDER BY song_length_seconds ASC
Limit 1;</sql><sql name="SQL 5">SELECT * 
FROM eurovision_winners e
JOIN song_details s ON s.year = e.year;</sql><sql name="SQL 6">SELECT e.song_name, e.year
FROM eurovision_winners e
JOIN song_details s ON e.year = s.year
WHERE s.solo_performance = TRUE;
</sql><sql name="SQL 7">SELECT count(language)
FROM song_details
WHERE language = &quot;English&quot;;</sql><sql name="SQL 8">SELECT ROUND(AVG(song_length_seconds), 2) AS avg_length
FROM song_details;</sql><sql name="SQL 9">SELECT year
FROM eurovision_winners
WHERE song_name = &quot;Hallelujah&quot;;</sql><sql name="SQL 10">SELECT year,  solo_performance
FROM song_details
WHERE solo_performance = FALSE
ORDER BY year
LIMIT 1;</sql><sql name="SQL 11">SELECT e.song_name, max(s.song_length_seconds) AS longest_song
FROM eurovision_winners e
JOIN song_details s ON s.year = e.year
ORDER BY s.song_length_seconds DESC
LIMIT 1;</sql><sql name="SQL 12">SELECT country, COUNT(*) AS wins
FROM eurovision_winners
GROUP BY country
ORDER BY wins DESC
LIMIT 1;</sql><sql name="SQL 13">SELECT year, country, count(country) AS wins
FROM eurovision_winners
GROUP BY country
ORDER BY wins DESC;</sql><sql name="SQL 14">SELECT e.song_name, e.winner, s.language
FROM eurovision_winners e
JOIN song_details s ON e.year = s.year
WHERE language LIKE &quot;French&quot;;</sql><sql name="SQL 15">SELECT country, MIN(year) AS first_win, MAX(year) AS last_win
FROM eurovision_winners
WHERE country IS &quot;Israel&quot;;
</sql><sql name="SQL 16">SELECT e.song_name, e.country, e.year, s.song_length_seconds
FROM eurovision_winners e
JOIN song_details s ON e.year = s.year
ORDER BY s.song_length_seconds DESC;</sql><sql name="SQL 17">SELECT e.song_name, e.country, ROUND(AVG(s.song_length_seconds), 2) AS avg_length
FROM eurovision_winners e
JOIN song_details s ON s.year = e.year
GROUP BY e.country
HAVING s.song_length_seconds &gt; avg_length
ORDER BY avg_length DESC;</sql><sql name="SQL 18">SELECT e.song_name, e.winner, s.song_length_seconds
FROM song_details s
JOIN eurovision_winners e
WHERE s.solo_performance IS TRUE
ORDER BY s.song_length_seconds ASC
LIMIT 1;</sql><sql name="SQL 19">SELECT e.country, ROUND(AVG(s.song_length_seconds), 2) AS avg_length
FROM eurovision_winners e
JOIN song_details s ON s.year = e.year
GROUP BY country
ORDER BY avg_length DESC;</sql><sql name="SQL 20">SELECT COUNT(language) AS lang_count
FROM song_details
WHERE language IS NOT &quot;English&quot;;</sql><sql name="SQL 21">SELECT COUNT(DISTINCT(genre)) AS genre_count
FROM song_details;</sql><sql name="SQL 22">SELECT year, winner, song_name
FROM eurovision_winners
WHERE country IS &quot;Israel&quot;
ORDER BY year DESC
LIMIT 1;</sql><current_tab id="7"/></tab_sql></sqlb_project>
